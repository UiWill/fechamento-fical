# Copie para .env e preencha. Nunca commitar o .env real.

# --- Postgres ---
POSTGRES_USER=afe
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=afe
DATABASE_URL=postgresql://afe:troque-esta-senha@localhost:5432/afe?schema=public

# --- Armazenamento de objetos (XMLs, PFX criptografado, exportacoes) ---
# Antes era MinIO - descontinuado (repositorio arquivado, sem mais binarios
# gratuitos pra Windows). Trocado por disco local; a pasta abaixo vira uma
# subpasta por "bucket" (afe-documentos-fiscais, afe-certificados, etc.)
OBJECT_STORAGE_PATH=C:\afe\object-storage

# --- Chave mestra de criptografia (envelope encryption dos certificados PFX) ---
# Gere com: openssl rand -hex 32
CERT_MASTER_KEY=

# --- Auth (core-api) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- fiscal-engine ---
FISCAL_ENGINE_URL=http://localhost:3100
FISCAL_ENGINE_PORT=3100
ACBR_AMBIENTE=2
# Gere com: openssl rand -hex 32 (usado por core-api e fiscal-engine — mesmo valor nos dois)
FISCAL_ENGINE_INTERNAL_KEY=

# --- core-api ---
CORE_API_PORT=3000

# --- admin-web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
ADMIN_WEB_PORT=3200
