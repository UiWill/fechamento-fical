# Copie para .env e preencha. Nunca commitar o .env real.

# --- Postgres ---
POSTGRES_USER=afe
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=afe
DATABASE_URL=postgresql://afe:troque-esta-senha@localhost:5432/afe?schema=public

# --- Redis (filas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- MinIO (armazenamento de XMLs e PFX criptografado) ---
MINIO_ROOT_USER=afe-admin
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_XMLS=afe-documentos-fiscais
MINIO_BUCKET_CERTIFICADOS=afe-certificados

# --- Chave mestra de criptografia (envelope encryption dos certificados PFX) ---
# Gere com: openssl rand -hex 32
CERT_MASTER_KEY=

# --- Auth (core-api) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- fiscal-engine ---
FISCAL_ENGINE_URL=http://localhost:3100
FISCAL_ENGINE_PORT=3100
ACBR_AMBIENTE=2

# --- core-api ---
CORE_API_PORT=3000

# --- admin-web ---
NEXT_PUBLIC_API_URL=http://localhost:3000
ADMIN_WEB_PORT=3200
