{
  "name": "@afe/agente-desktop",
  "version": "2.0.3",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build.mjs && electron dist-electron/main.js",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/renderer/tsconfig.json",
    "lint": "echo \"(lint a configurar)\""
  },
  "dependencies": {
    "@afe/shared": "workspace:*",
    "adm-zip": "^0.6.1",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "br.com.fechafiscal.agente",
    "productName": "Agente Fiscal",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/agente-fiscal.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Agente Fiscal"
    }
  }
}
