{
  "name": "automacao-fechamento-fiscal",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma multi-tenant de automacao do fechamento fiscal (projeto CAPTAL Contabilidade)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @afe/database prisma:generate",
    "db:migrate": "pnpm --filter @afe/database prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "koffi",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
